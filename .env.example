# Copy to .env and adjust. Nothing here is required for a local run.
POSTGRES_USER=capstone
POSTGRES_PASSWORD=capstone
POSTGRES_DB=capstone
WEB_PORT=8080
# Postgres published on 127.0.0.1 only, for eval scripts run from the host
DB_PORT=5433
# onnx (default, needs models/siglip2/text.onnx from the worker) or hash (no model, for smoke tests)
ENCODER_BACKEND=onnx
ENCODER_THREADS=4
WORKER_THREADS=8
# Optional LLM fallback for queries the rules cannot plan. Leave empty to disable.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
